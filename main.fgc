// types: int, input, time, move, null
// this is a comment

// null is a special word meaning nothing, it's the same as space " "
null > = null


// %number is an integer, as numbers may be used as directions in numpad notation

input 2 = gamepad.dir.down
input 4 = gamepad.dir.left
input 6 = gamepad.dir.right
input 8 = gamepad.dir.up
input 1 = 2+4 // left + down
input 3 = 2+6 // right + down
input 7 = 4+8 // left + up
input 9 = 6+8 // right + up

input P = gamepad.btn.x
input K = gamepad.btn.l1

// variables should be snake_case, as capital letters are often used for moves
// move pot_buster_motion = 6 [%1,%60] 2 [%1,%60] 4 [%1,%3] 6+P [%1,%60]
move mega_fist = 2 3 6 [%0,%5] | P | %15
// move pot_buster_motion = 6 2 4 [%1,%3] 6+P
// move double_buster = pot_buster_motion pot_buster_motion

// two_sided takes a move and broadens it for both sides
// move pot_buster_motion = two_sided(pot_buster_motion)

// limit is a function that takes a move and a int, and returns a move that is limited to that number of frames
// pot_buster = limit(pot_buster_motion, %15)


// kara_pot_buster_motion = 6 2 4 6-K ~ P
// kara_pot_buster_motion = two_sided(kara_pot_buster_motion)
// kara_pot_buster = limit(kara_pot_buster_motion, %15)
