// -----HELPER VARIABLES-----

frames > = [%0,%5]
frames ~ = [%1,%2]

// -----NUMPAD NOTATION-----

input 2 = gamepad.dir.down
input 4 = gamepad.dir.left
input 6 = gamepad.dir.right
input 8 = gamepad.dir.up

input 1 = 2+4 // left + down
input 3 = 2+6 // right + down
input 7 = 4+8 // left + up
input 9 = 6+8 // right + up

// -----BUTTONS (SET THESE TO THE BUTTONS YOU USE)------

input LP = gamepad.btn.b2
input MP = gamepad.btn.b3
input HP = gamepad.btn.b5
input LK = gamepad.btn.b0
input MK = gamepad.btn.b1
input HK = gamepad.btn.b7

// -----MOVES-----

move quarter_circle_L = 2 1 4 > | LP ; MP ; HP ; LK ; MK ; HP | %15
move quarter_circle_R = 2 3 6 > | LP ; MP ; HP ; LK ; MK ; HP | %15
move dragon_punch_L = 4 2 1 > | LP ; MP ; HP ; LK ; MK ; HP | %15
move dragon_punch_R = 6 2 3 > | LP ; MP ; HP ; LK ; MK ; HP | %15
move quarter_circle_x2_L = 2 4 2 4 > | LP ; MP ; HP ; LK ; MK ; HP | %15
move quarter_circle_x2_R = 2 6 2 6 > | LP ; MP ; HP ; LK ; MK ; HP | %15
move half_circle_clockwise = 6 2 4 > ; 2 4 8 > ; 4 8 6 > ; 8 6 2 > | LP ; MP ; HP ; LK ; MK ; HP | %30
move half_circle_counter_clock = 4 2 6 > ; 2 6 8 > ; 6 8 2 > ; 8 4 2 > | LP ; MP ; HP ; LK ; MK ; HP | %30
move half_circle_forward_L = 4 2 6 4 > ; 4 1 3 6 4 > | LP ; MP ; HP ; LK ; MK ; HP | %30
move half_circle_forward_R = 6 2 4 6 > ; 6 3 1 4 6 > | LP ; MP ; HP ; LK ; MK ; HP | %30
move 360_all = 4 2 6 8 > ; 6 2 4 8 > ; 8 4 2 6 > ; 8 6 2 4 > | LP ; MP ; HP ; LK ; MK ; HP | %30
move tiger_knee_L = 2 1 4 7 > | LP ; MP ; HP ; LK ; MK ; HP | %15
move tiger_knee_R = 2 3 6 9 > | LP ; MP ; HP ; LK ; MK ; HP | %15
