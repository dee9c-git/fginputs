// -----HELPER VARIABLES-----

frames > = [%0,%5]
frames ~ = [%1,%2]

// -----NUMPAD NOTATION-----

input 2 = gamepad.dir.down
input 4 = gamepad.dir.left
input 6 = gamepad.dir.right
input 8 = gamepad.dir.up

input 1 = 2+4 // left + down
input 3 = 2+6 // right + down
input 7 = 4+8 // left + up
input 9 = 6+8 // right + up

// -----BUTTONS (SET THESE TO THE BUTTONS YOU USE)------

input P = gamepad.btn.b2
input K = gamepad.btn.lb
input S = gamepad.btn.b3
input H = gamepad.btn.rb
input D = gamepad.btn.rs

// -----MOVES-----

move mega_fist_L = 2 1 4 > | P | %15
move mega_fist_R = 2 3 6 > | P | %15
move flick_L = 2 3 6 > | K | %15
move flick_R = 2 1 4 > | K | %15
move slide_head_L = 2 1 4 > | S | %15
move slide_head_R = 2 3 6 > | S | %15
move garuda_L = 2 3 6 > | H | %15
move garuda_R = 2 1 4 > | H | %15
move heat_tackle_L = 4 2 1 > | K | %15
move heat_tackle_R = 6 2 3 > | K | %15
move heat_knuckle_L = 4 2 1 > | H | %15
move heat_knuckle_R = 6 2 3 > | H | %15
move pot_buster_L = 4 2 6 4 > ; 4 1 3 6 4 > | P | %30
move pot_buster_R = 6 2 4 6 > ; 6 3 1 4 6 > | P | %30
move heavenly_buster_L = 4 2 6 4 > ; 4 1 3 6 4 > | S | %30
move heavenly_buster_R = 6 2 4 6 > ; 6 3 1 4 6 > | S | %30
move giganter_kai_L = 4 2 6 4 > ; 4 1 3 6 4 > | H | %30
move giganter_kai_R = 6 2 4 6 > ; 6 3 1 4 6 > | H | %30
move kara_pot_L = 4 2 6 4+K ~ ; 4 1 3 6 4+K ~ | P | %30
move kara_pot_R = 6 2 4 6+K ~ ; 6 3 1 4 6+K ~ | P | %30
move 360_buster = 4 2 6 8 > ; 6 2 4 8 > ; 8 4 2 6 > ; 8 6 2 4 > | P | %30
